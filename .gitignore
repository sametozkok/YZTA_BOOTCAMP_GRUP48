# ============================================
# AquaSentinel AI - .gitignore
# ============================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ---------- Veri Dosyaları ----------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# ---------- Ortam Değişkenleri ----------
.env

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Log Dosyaları ----------
logs/
*.log

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Virtual Environment ----------
venv/
.venv/
env/
