# Copernicus Dataspace Ecosystem (CDSE) Kimlik Bilgileri
# Hesap oluşturmak için: https://dataspace.copernicus.eu/
CDSE_USERNAME=your_email@example.com
CDSE_PASSWORD=your_password_here

# Opsiyonel: Log seviyesi (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
